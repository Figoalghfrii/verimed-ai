# =============================================================================
# VeriMed Monorepo Environment Configuration Example
# Copy this file to `.env` for local development. Never commit real secrets.
# =============================================================================

# --- Application Environment ---
APP_ENV=development
APP_NAME=VeriMed API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Backend API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- PostgreSQL + pgvector Database ---
POSTGRES_USER=verimed
POSTGRES_PASSWORD=verimed_dev_password
POSTGRES_DB=verimed_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://verimed:verimed_dev_password@localhost:5432/verimed_db
DATABASE_SYNC_URL=postgresql+psycopg://verimed:verimed_dev_password@localhost:5432/verimed_db

# --- AI Pipeline Configuration ---
# Options for AI_PROVIDER:
#   mock         -> Stateless deterministic demonstration mode (default, no DB corpus needed)
#   hybrid       -> PostgreSQL pgvector + tsvector hybrid retrieval with deterministic grounded explainer
#   configurable -> PostgreSQL hybrid retrieval + OpenAI-compatible LLM endpoint
AI_PROVIDER=mock
EMBEDDING_BACKEND=hash
RERANKER_BACKEND=lexical
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_MIN_SCORE=0.35

# Optional external/local OpenAI-compatible LLM (used only when AI_PROVIDER=configurable)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20.0

# --- Frontend Public Configuration ---
NEXT_PUBLIC_APP_NAME=VeriMed
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
